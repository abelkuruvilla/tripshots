{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TripShots",
  "version": "0.1.0",
  "identifier": "app.tripshots.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TripShots",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Beat-synced reels from your own travel footage",
    "longDescription": "TripShots turns your own travel photos and clips into beat-synced Instagram Reels, learns styles from reels you like, and works with AI agents over MCP.",
    "copyright": "Copyright (c) Abel Kuruvilla",
    "license": "MIT",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "section": "video" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCOEUyQkM5QjBCNzYzOUEKUldTYVk3ZXd5U3VPS3pCR3M4Sy92cVg1SWZ4VjBGb1diR3QrKzduRU1FaUlwdkc1cEhLcHM1Y0gK",
      "endpoints": ["https://github.com/abelkuruvilla/tripshots/releases/latest/download/latest.json"]
    }
  }
}
