# Copy to ~/.tripshots/.env (or ./.env) and fill in what you use.

# Which AI judges your shots: auto | claude-cli | api | minimax | none
# auto = claude CLI if installed (uses your Claude subscription), else API keys below.
TRIPSHOTS_BACKEND=auto

# Optional: model for the claude CLI backend (e.g. sonnet, opus). Blank = your Claude Code default.
# TRIPSHOTS_CLAUDE_MODEL=sonnet

# MiniMax (Anthropic-compatible endpoint). Needs an image-capable model (MiniMax-M3).
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# TRIPSHOTS_MODEL=MiniMax-M3

# Claude API key (pay-per-use; not needed if you use the claude CLI with a subscription)
# ANTHROPIC_API_KEY=

# Optional: Gemini watches each clip once (480p proxy, deleted after) for its best instant, shake, tilt
# and in-camera whip pans. Free key: https://aistudio.google.com/apikey. TRIPSHOTS_WATCH=auto|gemini|off
# GEMINI_API_KEY=
# TRIPSHOTS_GEMINI_MODEL=gemini-flash-latest

# Video encoder: auto (hardware when it works: VideoToolbox on a Mac, NVENC / Quick Sync on a PC) | hardware | software
# TRIPSHOTS_ENCODER=auto

# Agents / `tripshots find`: where your footage and music live (separate several with ':'), where reels go
# TRIPSHOTS_FOOTAGE=/Users/you/Pictures/Trips:/Volumes/SSD/Footage
# TRIPSHOTS_MUSIC=/Users/you/Music/Reels
# TRIPSHOTS_OUT=/Users/you/Movies/Reels
# Required for `tripshots mcp --http` beyond this computer (clients send Authorization: Bearer <token>)
# TRIPSHOTS_MCP_TOKEN=

# Browser you're logged in to Instagram with (for reel links: music + learn)
# TRIPSHOTS_COOKIES_BROWSER=chrome
